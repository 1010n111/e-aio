# 本地编排样例值（复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实凭据）
# 这些值是**本地开发用的默认值**，不是任何环境的真实凭据。

# PostgreSQL（镜像 pgvector/pgvector:pg17，与 CI 一致）
POSTGRES_DB=eaio
POSTGRES_USER=eaio
POSTGRES_PASSWORD=eaio
POSTGRES_PORT=5432

# Redis（镜像 redis:7-alpine）
REDIS_PORT=6379

# 后端本地 profile 用的连接串（application-local.yml 的默认值与此一致）
SPRING_PROFILES_ACTIVE=local
