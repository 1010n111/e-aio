<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eaio</groupId>
    <artifactId>e-aio</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>e-aio-app</artifactId>
  <name>e-aio-app</name>
  <description>应用壳：唯一启动类与装配层（Web 入站链路、多实例迁移装配）；不含业务代码</description>

  <dependencies>
    <!-- 被装配的模块：应用壳是唯一依赖全部模块的装配方 -->
    <dependency>
      <groupId>com.eaio</groupId>
      <artifactId>e-aio-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.eaio</groupId>
      <artifactId>e-aio-platform</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- P0 运行依赖（P0 册 3.1.2 基线）：Actuator 与结构化日志编码器随 T8/后续引入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aspectj</artifactId>
    </dependency>

    <!-- 数据访问与迁移（每模块独立 Flyway 实例，装配见 com.eaio.app.config.ModuleFlywayConfig） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：P0 仅用于幂等占位（P0 册 3.2.5）；RedisKit 门面与 Redisson 随 P1 引入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 全应用唯一启动类：com.eaio.EaioApplication（不使用 @ComponentScan 白名单） -->
          <mainClass>com.eaio.EaioApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>


