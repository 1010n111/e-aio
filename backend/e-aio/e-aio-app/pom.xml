<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eaio</groupId>
    <artifactId>e-aio</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>e-aio-app</artifactId>
  <name>e-aio-app</name>
  <description>应用壳：唯一启动类与装配层（Web 入站链路、多实例迁移装配）；不含业务代码</description>

  <dependencies>
    <!-- 被装配的模块：应用壳是唯一依赖全部模块的装配方 -->
    <dependency>
      <groupId>com.eaio</groupId>
      <artifactId>e-aio-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.eaio</groupId>
      <artifactId>e-aio-platform</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- P0 运行依赖（P0 册 3.1.2 基线）：结构化日志编码器随 T8/后续引入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aspectj</artifactId>
    </dependency>
    <!-- 健康检查 /actuator/health：本地编排与 CI 的可达性探测（P0 册 3.8/5.2） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 数据访问与迁移（每模块独立 Flyway 实例，装配见 com.eaio.app.config.ModuleFlywayConfig） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!--
      Flyway 12 起数据库方言拆成独立模块：只引 flyway-core 时 Flyway **不报错也不迁移**，
      表现为"什么都没做"；CI 上以 "Unsupported Database: PostgreSQL 17.11" 才暴露。
      因此 PostgreSQL 方言必须显式引入（P0 册 3.1.2 基线里的 flyway-database-postgresql）。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Redis：P0 仅用于幂等占位（P0 册 3.2.5）；RedisKit 门面与 Redisson 随 P1 引入 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 模块化单体：应用壳是唯一的 Modulith 应用（P0 册 3.7） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <!-- 架构护栏：Modulith 校验 + ArchUnit 规则，仅测试范围（P0 册 3.7） -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 集成测试：Testcontainers（版本由 testcontainers-bom 管；注意 2.x 的坐标带前缀） -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 全应用唯一启动类：com.eaio.EaioApplication（不使用 @ComponentScan 白名单） -->
          <mainClass>com.eaio.EaioApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>


