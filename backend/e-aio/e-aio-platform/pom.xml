<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eaio</groupId>
    <artifactId>e-aio</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>e-aio-platform</artifactId>
  <name>e-aio-platform</name>
  <description>平台支撑模块：P0 仅承载平台自有迁移脚本（classpath:db/migration/platform），无业务代码</description>

  <!--
    P1 起本模块承载平台业务代码。依赖方向（P1 册 2.4.1、ADR-0005）：
    编译期只依赖通用能力层（e-aio-common），**对 iam/audit 等业务模块零依赖**——
    需要组织上下文与审计时走自有端口 com.eaio.platform.api.port，由应用壳注入适配器。
    持久层（MyBatis-Plus）与 Redis（Redisson）随各自首个消费者引入，见各期票。
  -->
  <dependencies>
    <!-- 通用能力层：契约（Result/PageResult/ErrorCode）、门面（JsonUtils/RedisKit/RedisKeys） -->
    <dependency>
      <groupId>com.eaio</groupId>
      <artifactId>e-aio-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- 只为根包声明 @ApplicationModule（模块侧登记）：modulith-api 不引 Spring 容器与启动器 -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>

    <!--
      REST 控制器（P1 册 2.3 分包裁决 P1-C1：Controller 放 infrastructure/web，不放 api 包）。
      app 壳已经带了 starter-web；这里显式声明是为了让 platform 单独编译/测试时也有 web 类型。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 入参校验（java-conventions.md：DTO/Cmd 用 jakarta.validation 注解，Controller 上 @Valid） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 权限点注解（P1 册 7.3）：iam 交付前 @PreAuthorize 是**契约载体**（由 PermissionCodeContractTest
         与设计册比对），不生效的授权由 iam 的 spring-security-config 接管。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>

    <!-- 持久层：MyBatis-Plus（P1 册 2.5 与 tech-stack.md 冻结：Boot 4 starter + 3.5.17） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>3.5.17</version>
    </dependency>
    <!--
      分页/乐观锁拦截器所在模块：MyBatis-Plus 3.5.9 起把依赖 jsqlparser 的拦截器（分页）拆到
      mybatis-plus-jsqlparser，starter 不再传递。缺它时 PaginationInnerInterceptor 直接编译不过
      （比运行期"分页静默失效"友好）。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>3.5.17</version>
    </dependency>

    <!-- 一级缓存：Caffeine（P1 册 3.1.3 的 L1，本机缓存；版本由 Boot 统一管理） -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!--
      二级缓存（L2）与失效：正常读写走 common 的 RedisKit 门面；但"按前缀清理"（P1 册 3.1.5
      "失效用前缀删除 + 广播，而不是单键删除"）RedisKit 的冻结方法集里没有，那一件事直接用
      StringRedisTemplate（scan + delete）。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- MapStruct：实体 ↔ DTO（裁决 P1-C3）。处理器用 provided，编译期生效、不进运行时依赖。 -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct-processor</artifactId>
      <version>${mapstruct.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      任务分布式锁（P1 册 3.4.2、4.3.11）：ShedLock 7.10.1，JDBC template provider + usingDbTime()，
      锁表 eaio_platform.shedlock（V5 显式建表，列名/类型是 provider 的 SQL 契约）。
      只引 core + provider-jdbc-template（两者都直接用到：LockProvider/LockConfiguration/SimpleLock、
      JdbcTemplateLockProvider），不引 shedlock-spring：本票的调度是从 job 表动态建 CronTrigger，
      没有 @Scheduled 注解可挂，@EnableSchedulerLock 的注解 AOP 用不上（见《实现注记（T7）》）。
      provider 传递 spring-jdbc（版本仍由 Boot BOM 统一管理）与 jspecify（Apache-2.0，许可证白名单内）。
    -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-core</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
  </dependencies>
</project>
