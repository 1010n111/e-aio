<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.eaio</groupId>
  <artifactId>e-aio</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>e-aio</name>
  <description>e-aio 企业级一体化管理系统（模块化单体）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 框架补丁浮动：下列两项与 Boot 配套，只写小版本（P0 册 3.1.2 版本策略） -->
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <archunit.version>1.5.0</archunit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <!-- 实体 ↔ DTO 映射（P1 册裁决 P1-C3：MapStruct，componentModel=spring、unmappedTargetPolicy=ERROR） -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <!-- checkstyle 规则集（P1 M1 冻结，含门禁级别）：见 config/checkstyle/checkstyle.xml 头部说明。
         工具版本随插件默认（插件版本已锁），不额外 pin checkstyle 版本，避免引入未验证的 artifact。 -->
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <!-- 依赖漏洞扫描（P0 册 3.8 阶段 6 的 CVE 部分；P1-2 册「CI 阶段扩展」启用）：
         插件 requiredJavaVersion=11，本工程 JDK 21 可用；版本锁定，不随插件默认浮动。
         锁 12.1.9 而非 13.0.0（实测，2026-09-19）：13.0.0 在**未配置 NVD_API_KEY** 时匿名同步直接失败
         （`NvdApiException: Invalid API Key, length of 0 too short to provided a masked partial key`
         → `UpdateException: Error updating the NVD Data` → `NoDataException: No documents exist`），
         12.1.9 同一命令、同一环境可正常匿名同步（日志 "An NVD API Key was not provided" 后开始下载 NVD 记录）。 -->
    <dependency-check-maven.version>12.1.9</dependency-check-maven.version>
  </properties>

  <!--
    模块清单（P0）：
      e-aio-app       应用壳：唯一启动类 + Web/基础设施装配，不含业务代码
      e-aio-platform  平台支撑模块：P0 仅承载平台自有迁移脚本，无业务代码
      e-aio-common    通用能力层：纯技术代码，不依赖任何模块
    依赖版本：由 spring-boot-starter-parent 的 BOM 统一管理（框架补丁浮动），
    其余依赖在引入时精确锁定；P0 未引入的依赖见 P0 册 3.1.2 版本策略。
  -->
  <modules>
    <module>e-aio-common</module>
    <module>e-aio-platform</module>
    <module>e-aio-app</module>
  </modules>

  <dependencies>
    <!-- 测试：JUnit 5 + AssertJ + Spring Test（版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

    <dependencyManagement>
      <dependencies>
        <!-- Boot BOM 不含 Modulith 与 ArchUnit：这两项自行锁定（P0 册 3.1.2 已核实版本） -->
        <dependency>
          <groupId>org.springframework.modulith</groupId>
          <artifactId>spring-modulith-bom</artifactId>
          <version>${spring-modulith.version}</version>
          <type>pom</type>
          <scope>import</scope>
        </dependency>
        <dependency>
          <groupId>com.tngtech.archunit</groupId>
          <artifactId>archunit-junit5</artifactId>
          <version>${archunit.version}</version>
        </dependency>
        <!-- Testcontainers 2.x 的坐标变了（-postgresql/-junit-jupiter）：显式导入其 BOM，避免版本漂移 -->
        <dependency>
          <groupId>org.testcontainers</groupId>
          <artifactId>testcontainers-bom</artifactId>
          <version>${testcontainers.version}</version>
          <type>pom</type>
          <scope>import</scope>
        </dependency>
        <dependency>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </dependency>
        <dependency>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </dependency>
      </dependencies>
    </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check-maven.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Mockito 5 的 inline mock maker 需要 JVM 允许自附加 agent；JDK 21 起默认禁止
        （jdk.attach.allowAttachSelf=false），实测表现为 "Could not initialize plugin:
        interface org.mockito.plugins.MockMaker"——与业务代码无关但会让测试全红。
        显式放行，保证 `mvn -B test` 在任何 JDK 21 环境都能直接跑。
        注：这里直接写 argLine 会覆盖命令行 `-DargLine`；将来引入 JaCoCo 等需要 argLine 的插件时，
        把它的参数并入这一行（不要另起一个 argLine）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
        </configuration>
      </plugin>
      <!--
        集成测试（*IT）与单元测试（*Test）分开：`mvn -B test` 只跑单测与架构测试（无容器也能全绿），
        `mvn -B verify` 追加 Failsafe 跑 Testcontainers 集成测试（P0 册 3.8 阶段 5）。
        `-DskipITs` 跳过集成测试：无 Docker 机器的降级路径（权威验证在 CI）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        后端 Lint（P0 册 3.8 阶段 2；规则集与门禁级别在 P1 M1 冻结，P1-2 册 §CI 阶段扩展）。
        规则集用 maven.multiModuleProjectDirectory 定位：configLocation 若写成相对路径会按“各模块
        basedir”解析，子模块（e-aio-common/…）会找不到文件而静默不检查。
        绑定 validate 阶段 → `mvn -B compile|test|verify` 都先过 Lint；`mvn -B checkstyle:check` 可单独跑。
        门禁级别 = 违规即失败（severity=error + failOnViolation）；测试源码也在范围内（测例同样是代码）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>error</violationSeverity>
          <!--
            启动类豁免：HideUtilityClassConstructor 命中"只有 main 的类"，但 @SpringBootApplication
            是配置类，Spring 要实例化/CGLIB 子类化它，加私有构造器会让应用起不来——该规则的已知误报。
            只此文件豁免（不用全局 suppressions 文件，省掉一个相对路径解析点）。
          -->
          <excludes>**/EaioApplication.java</excludes>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-lint</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- License 扫描（P0 册 3.8 阶段 6）：生成依赖许可证清单，白名单外/缺失即失败；CVE 扫描属 P1。
           参数名必须是 includedLicenses——写成 licenses 会被插件静默忽略（实测踩到），变成"只出报告不校验"。 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <configuration>
          <failOnMissing>true</failOnMissing>
          <acceptPomPackaging>true</acceptPomPackaging>
          <includedLicenses>
            <includedLicense>Apache-2.0</includedLicense>
            <includedLicense>Apache License, Version 2.0</includedLicense>
            <includedLicense>Apache 2</includedLicense>
            <includedLicense>Apache 2.0</includedLicense>
            <includedLicense>Apache License 2.0</includedLicense>
            <includedLicense>Apache Software License, Version 2.0</includedLicense>
            <includedLicense>The Apache Software License, Version 2.0</includedLicense>
            <includedLicense>MIT</includedLicense>
            <includedLicense>MIT License</includedLicense>
            <includedLicense>The MIT License</includedLicense>
            <includedLicense>EPL-2.0</includedLicense>
            <includedLicense>EPL 2.0</includedLicense>
            <includedLicense>Eclipse Public License - v 2.0</includedLicense>
            <includedLicense>Eclipse Public License v2.0</includedLicense>
            <includedLicense>EDL-1.0</includedLicense>
            <includedLicense>Eclipse Distribution License - v 1.0</includedLicense>
            <includedLicense>BSD-2-Clause</includedLicense>
            <includedLicense>BSD-3-Clause</includedLicense>
            <includedLicense>PostgreSQL</includedLicense>
            <includedLicense>PostgreSQL License</includedLicense>
            <includedLicense>The PostgreSQL License</includedLicense>
            <includedLicense>MulanPSL-2.0</includedLicense>
            <includedLicense>UPL-1.0</includedLicense>
            <includedLicense>Universal Permissive License, Version 1.0</includedLicense>
            <includedLicense>LGPL-2.1-only</includedLicense>
            <includedLicense>GNU Lesser General Public License</includedLicense>
            <includedLicense>CDDL-1.1</includedLicense>
            <includedLicense>CDDL+GPLv2</includedLicense>
          </includedLicenses>
        </configuration>
        <executions>
          <execution>
            <id>license-report</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        依赖漏洞扫描（P0 册 3.8 阶段 6 的 CVE 部分；P1-2 册「CI 阶段扩展」启用）。

        刻意**不绑定任何生命周期阶段**（该 mojo 自带默认 phase=verify，这里不声明 executions 即不参与构建）：
        首次同步 NVD 数据库 + 逐依赖分析要几分钟到几十分钟，绑进 validate/verify 会把本地构建与
        集成测试构建一起拖垮。由 CI 阶段 6 的作业显式调用：
          cd backend/e-aio && mvn -B org.owasp:dependency-check-maven:check

        失败语义（"高危未评审即阻断"）：发现 CVSS >= 7 且未被 config/dependency-check/suppressions.xml
        评审接纳的漏洞时构建失败（failBuildOnCVSS=7）。抑制文件当前为**空列表**——未评审 = 失败。

        NVD API Key：由环境变量 NVD_API_KEY 提供（CI secret；参数 nvdApiKeyEnvironmentVariable 即指该变量）。
        未设置也能跑，但 NVD 对匿名调用限流（5 请求/30 秒），首次同步会非常慢。
        报告：HTML + JSON，落在各模块 target/dependency-check-report.{html,json}。

        注意：调用 CLI 目标时不走生命周期，因此不会触发 checkstyle/license 等其他门禁——它们由
        CI 的 backend/integration/license 作业承担（阶段 1–5 权威）。
      -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
          <suppressionFiles>
            <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check/suppressions.xml</suppressionFile>
          </suppressionFiles>
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
          <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>


