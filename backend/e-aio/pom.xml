<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.eaio</groupId>
  <artifactId>e-aio</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>e-aio</name>
  <description>e-aio 企业级一体化管理系统（模块化单体）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <!--
    模块清单（P0）：
      e-aio-app       应用壳：唯一启动类 + Web/基础设施装配，不含业务代码
      e-aio-platform  平台支撑模块：P0 仅承载平台自有迁移脚本，无业务代码
      e-aio-common    通用能力层：纯技术代码，不依赖任何模块
    依赖版本：由 spring-boot-starter-parent 的 BOM 统一管理（框架补丁浮动），
    其余依赖在引入时精确锁定；P0 未引入的依赖见 P0 册 3.1.2 版本策略。
  -->
  <modules>
    <module>e-aio-common</module>
    <module>e-aio-platform</module>
    <module>e-aio-app</module>
  </modules>

  <dependencies>
    <!-- 测试：JUnit 5 + AssertJ + Spring Test（版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
